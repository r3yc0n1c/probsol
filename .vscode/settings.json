{
    "files.autoSave": "afterDelay",
    "editor.fontFamily": "'FiraCode Nerd Font Mono', Consolas, 'Courier New', monospace",
    "workbench.sideBar.location": "right",
    "editor.minimap.enabled": false,
    "workbench.colorCustomizations": {
        "editor.selectionBackground": "#33467C", // Tokyo Night selection background
        "editor.selectionHighlightBackground": "#3B4261", // subtle highlight background
        "editor.selectionHighlightBorder": "#82Aaff" // Tokyo Night blue accent
    },
    "editor.rulers": [
        {
            "column": 80,
            "color": "#3B4261"
        }
    ],
    "editor.wordWrap": "wordWrapColumn",
    "editor.wordWrapColumn": 80
}